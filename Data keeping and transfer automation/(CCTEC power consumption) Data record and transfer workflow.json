      "id": "ed80c4af-5f57-441d-9d00-dfb8699c3696",
      "name": "Get row(s) in sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        288,
        -80
      ],
      "executeOnce": true,
