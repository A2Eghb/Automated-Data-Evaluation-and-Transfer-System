    {
      "parameters": {
        "jsCode": "// n8n Code node — paste this in, set mode to \"Run Once for All Items\"\n//\n// This node receives ALL rows from the worksheet (new submission + every\n// existing row). It automatically picks out:\n//   - the NEWEST row  -> treated as Input 2 (the new submission)\n//   - the row before it -> treated as Input 1 (last existing data)\n// then runs the same EPAIL / Glass Fac. arithmetic as before.\n\n// ===================== CONFIG =====================\n// The field holding each row's number. Google Sheets nodes in n8n return\n// this as 'row_number' by default. Rows are sorted by it numerically, so\n// the highest row number = newest row, and the next highest = previous row.\n// Leave as '' to just trust the order rows already arrive in.\nconst ROW_FIELD = 'row_number';\n// ======================================================\n\nlet items = $input.all().map(i => i.json);\n\nif (items.length < 2) {\n  throw new Error(\n    `Need at least 2 rows to compare (a new submission + prior data). Only received ${items.length}.`\n  );\n}\n\nif (ROW_FIELD) {\n  items = [...items].sort((a, b) => Number(a[ROW_FIELD]) - Number(b[ROW_FIELD]));\n}\n\nconst newSubmission = items[items.length - 1];   // Input 2\nconst lastExisting = items[items.length - 2];    // Input 1\n\nconst categories = [\n  'Welding & Balistic',\n  'Office Complex',\n  'Injection',\n  'Power House',\n  'Meter Assembly',\n  'Showroom',\n  'Vehicle assembly & Shooting range',\n  'Glass roller',\n  'Glass Factory',\n];\n\n// Step 1: subtract last existing data from the new submission, per category\nconst diffs = {};\nfor (const key of categories) {\n  const v1 = Number(lastExisting[key]) || 0;\n  const v2 = Number(newSubmission[key]) || 0;\n  diffs[key] = v2 - v1;\n}\n\n// Step 2: roll up into the two combined metrics\nconst EPAIL = diffs['Welding & Balistic'] + diffs['Showroom'] + diffs['Vehicle assembly & Shooting range'];\nconst glassFac = diffs['Glass roller'] + diffs['Glass Factory'];\n\n// Step 3: build final structured output (7 values total)\n// PERIOD??? is carried over as-is from the new submission — not calculated.\nconst output = {\n  'EPAIL': EPAIL,\n  'Glass Fac.': glassFac,\n  'Office Complex': diffs['Office Complex'],\n  'Injection': diffs['Injection'],\n  'Power House': diffs['Power House'],\n  'Meter Assembly': diffs['Meter Assembly'],\n  'PERIOD': newSubmission['Period'],\n  'Timestamp': newSubmission['Timestamp'],\n};\n\nreturn [{ json: output }];"
      },
      "id": "4b0ddd67-ed5c-478c-82a1-d6d33dbd2598",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        -80
      ]
    },
